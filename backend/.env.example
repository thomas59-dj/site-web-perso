=thoms5960@gmail.com
# Copier ce fichier en ".env" puis renseigner vos identifiants.
# Sans configuration SMTP, le serveur fonctionne quand même : les demandes
# sont simplement enregistrées dans backend/data/submissions.json.

PORT=3000

# --- SMTP (envoi d'email) ---
# Exemple avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# (nécessite un "mot de passe d'application" Google, pas le mot de passe du compte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=thoms5960@gmail.com
SMTP_PASS=zvqd hxcc obqe aqmd

# Adresse qui recevra les demandes de contact (par défaut : SMTP_USER)
CONTACT_TO_EMAIL=thoms5960@gmail.com
